[Unit]
Description=SSH CLI gateway for ContextQA test steps
After=network-online.target
Wants=network-online.target

[Service]
User=ssh-gateway
Group=ssh-gateway
EnvironmentFile=/etc/ssh-gateway.env
WorkingDirectory=/opt/ssh-gateway/app/src
ExecStart=/opt/ssh-gateway/venv/bin/python server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
